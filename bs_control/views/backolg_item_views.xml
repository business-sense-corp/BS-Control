    <record id="view_bs_backlog_item_kanban" model="ir.ui.view">
        <field name="name">bs.backlog.item.kanban</field>
        <field name="model">bs.backlog.item</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" group_create="false" group_delete="false">
                <field name="name" />
                <field name="partner_id" />
                <field name="project_id" />
                <field name="assigned_user_id" />
                <field name="priority" />
                <field name="estimated_hours" />
                <field name="due_date" />
                <field name="status" />

                <templates>
                    <t t-name="card">

                        <!-- Task Name -->
                        <div class="fw-bold fs-6 mb-2">
                            <field name="name" />
                        </div>

                        <!-- Customer -->
                        <div t-if="record.partner_id.raw_value"
                            class="d-flex align-items-center gap-1 text-muted small mb-1">
                            <i class="fa fa-building-o" aria-hidden="true" />
                            <field name="partner_id" />
                        </div>

                        <!-- Project -->
                        <div t-if="record.project_id.raw_value"
                            class="d-flex align-items-center gap-1 text-muted small mb-1">
                            <i class="fa fa-folder-o" aria-hidden="true" />
                            <field name="project_id" />
                        </div>

                        <!-- Priority -->
                        <div class="d-flex align-items-center gap-1 text-muted small mb-1">
                            <i class="fa fa-flag-o" aria-hidden="true" />
                            <field name="priority" />
                        </div>

                        <!-- Footer -->
                        <div
                            class="d-flex justify-content-between align-items-center pt-2 mt-2 border-top">

                            <!-- Assigned User -->
                            <div t-if="record.assigned_user_id.raw_value">
                                <field name="assigned_user_id"
                                    widget="many2one_avatar_user"
                                    readonly="1" />
                            </div>
                            <span t-else="" class="text-muted small">
                                <i class="fa fa-user-o" /> Unassigned </span>

                            <!-- Estimated Hours + Due Date -->
                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <span t-if="record.estimated_hours.raw_value">
                                    <i class="fa fa-clock-o" />
                                <field name="estimated_hours" />h </span>
                                <span t-if="record.due_date.raw_value">
                                    <i class="fa fa-calendar" />
                                    <field name="due_date" />
                                </span>
                            </div>

                        </div>

                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- ===================================================== -->
    <!-- ACTION -->
    <!-- ===================================================== -->

    <record id="action_bs_backlog" model="ir.actions.act_window">
        <field name="name">Backlog</field>

        <field name="res_model">bs.backlog.item</field>

        <field name="view_mode">kanban,list,form</field>
    </record>

