<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- LIST VIEW -->
    <!-- ===================================================== -->

    <record id="view_bs_backlog_item_list" model="ir.ui.view">
        <field name="name">bs.backlog.item.list</field>
        <field name="model">bs.backlog.item</field>

        <field name="arch" type="xml">
            <list>

                <field name="name" />

                <field name="task_type" />

                <field name="partner_id" />

                <field name="project_id" />

                <field name="assigned_user_id" />

                <field name="priority" />

                <field name="estimated_hours" />

                <field name="status" />

                <field name="lifecycle_state" />

                <field name="due_date" />

                <field name="department_id" />

                <field name="is_billable" />

            </list>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- FORM VIEW -->
    <!-- ===================================================== -->

    <record id="view_bs_backlog_item_form" model="ir.ui.view">
        <field name="name">bs.backlog.item.form</field>
        <field name="model">bs.backlog.item</field>

        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_move_to_sprint_wizard"
                        type="object"
                        string="Move To Sprint"
                        class="btn-primary"
                        invisible="lifecycle_state == 'active_sprint'" />
                </header>
                <sheet>

                    <!-- BASIC INFO -->
                    <group string="Basic Information">

                        <group>
                            <field name="name" />
                            <field name="task_type" />
                            <field name="priority" />
                        </group>

                        <group>
                            <field name="status" />
                            <field name="lifecycle_state" />
                        </group>

                    </group>


                    <!-- RELATIONS -->
                    <group string="Relations">

                        <group>
                            <field name="partner_id" />
                            <field name="project_id"
                                domain="[('partner_id', '=', partner_id), ('partner_id', '!=', False)]"
                                context="{'default_partner_id': partner_id}" />
                        </group>

                        <group>
                            <field name="assigned_user_id" />
                            <field name="department_id" />
                        </group>

                    </group>


                    <!-- PLANNING -->
                    <group string="Planning">

                        <group>
                            <field name="estimated_hours" />
                            <field name="story_points" />
                        </group>

                        <group>
                            <field name="due_date" />
                            <field name="is_billable" />
                        </group>

                    </group>


                    <!-- DESCRIPTION -->
                    <group string="Description">

                        <field name="description" />

                        <field name="definition_of_done" />

                    </group>


                    <!-- SYSTEM INFO -->
                    <group string="System Information">

                        <group>
                            <field name="create_uid" readonly="1" />
                        </group>

                        <group>
                            <field name="create_date" readonly="1" />
                        </group>

                    </group>

                </sheet>

                <chatter />

            </form>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- SEARCH VIEW -->
    <!-- ===================================================== -->
    <record id="view_bs_backlog_item_search" model="ir.ui.view">
        <field name="name">bs.backlog.item.search</field>
        <field name="model">bs.backlog.item</field>
        <field name="arch" type="xml">
            <search>

                <field name="name" />
                <field name="partner_id" />
                <field name="project_id" />
                <field name="assigned_user_id" />

                <filter name="my_tasks"
                    string="My Tasks"
                    domain="[('assigned_user_id', '=', uid)]" />

                <filter name="unassigned"
                    string="Unassigned Tasks"
                    domain="[('assigned_user_id', '=', False)]" />

                <separator />

                <filter name="no_project"
                    string="No Project"
                    domain="[('project_id', '=', False)]" />

                <filter name="has_project"
                    string="Has Project"
                    domain="[('project_id', '!=', False)]" />

                <separator />

                <filter name="billable"
                    string="Billable"
                    domain="[('is_billable', '=', True)]" />

                <filter name="non_billable"
                    string="Non-Billable"
                    domain="[('is_billable', '=', False)]" />

                <separator />

                <filter name="todo"
                    string="To Do"
                    domain="[('status', '=', 'todo')]" />

                <filter name="progress"
                    string="In Progress"
                    domain="[('status', '=', 'in_progress')]" />

                <filter name="blocked"
                    string="Blocked"
                    domain="[('status', '=', 'blocked')]" />

                <filter name="done"
                    string="Done"
                    domain="[('status', '=', 'done')]" />

                <separator />

                <filter name="backlog"
                    string="Backlog"
                    domain="[('lifecycle_state', '=', 'backlog')]" />

                <filter name="planned"
                    string="Planned"
                    domain="[('lifecycle_state', '=', 'planned')]" />

                <filter name="active_sprint"
                    string="Active Sprint"
                    domain="[('lifecycle_state', '=', 'active_sprint')]" />

                <!-- Group by -->
                <group name="group_filters">

                    <filter name="group_by_task_type"
                        string="Task Type"
                        context="{'group_by': 'task_type'}" />

                    <filter name="group_by_customer"
                        string="Customer"
                        context="{'group_by': 'partner_id'}" />

                    <filter name="group_by_project"
                        string="Project"
                        context="{'group_by': 'project_id'}" />

                    <filter name="group_by_user"
                        string="Assigned User"
                        context="{'group_by': 'assigned_user_id'}" />

                    <filter name="group_by_priority"
                        string="Priority"
                        context="{'group_by': 'priority'}" />

                    <filter name="group_by_status"
                        string="Status"
                        context="{'group_by': 'status'}" />

                    <filter name="group_by_lifecycle"
                        string="Lifecycle State"
                        context="{'group_by': 'lifecycle_state'}" />

                    <filter name="group_by_department"
                        string="Department"
                        context="{'group_by': 'department_id'}" />

                    <filter name="group_by_billable"
                        string="Billable"
                        context="{'group_by': 'is_billable'}" />

                </group>

            </search>

        </field>
    </record>
