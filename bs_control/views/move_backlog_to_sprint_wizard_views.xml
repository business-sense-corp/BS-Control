<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_move_backlog_to_sprint_wizard_form" model="ir.ui.view">
    <field name="name">bs.move.backlog.to.sprint.wizard.form</field>
    <field name="model">bs.move.backlog.to.sprint.wizard</field>
    <field name="arch" type="xml">
      <form string="Move Backlog To Sprint">
        <sheet>
          <group>
            <field name="backlog_item_id" />
            <field name="project_id" />
            <field name="sprint_id" domain="[('status','in',['planning','draft'])]"/>
          </group>

          <group string="Assignment">
            <field name="assigned_user_id" />
            <field name="estimated_hours" />
            <field name="priority" />
          </group>

          <group string="Dates">
            <field name="start_date" />
            <field name="end_date" />
          </group>

          <group>
            <field name="set_backlog_as_planned" />
          </group>
        </sheet>

        <footer>
          <button name="action_move_to_sprint"
            type="object"
            string="Move To Sprint"
            class="btn-primary" />

          <button string="Cancel"
            special="cancel"
            class="btn-secondary" />
        </footer>
      </form>
    </field>
  </record>

</odoo>