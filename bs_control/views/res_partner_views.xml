<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Inherit Partner Form View -->
  <record id="view_partner_form_inherit_bs_control" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.bs.control</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">

      <xpath expr="//sheet/notebook" position="inside">
        <page string="BS Control Information" name="bs_control_information">
          <group>
            <group string="Client Classification">
              <field name="x_client_status" />
              <field name="x_industry" />
              <field name="x_client_type" />
            </group>

            <group string="Notes">
              <field name="x_notes" nolabel="1" placeholder="Add internal BS Control notes here..." />
            </group>
          </group>
        </page>
      </xpath>

    </field>
  </record>


  <!-- Inherit Partner Search View -->
  <record id="view_res_partner_filter_inherit_bs_control" model="ir.ui.view">
    <field name="name">res.partner.search.inherit.bs.control</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter" />
    <field name="arch" type="xml">

      <xpath expr="//search" position="inside">

        <separator />

        <!-- Searchable Fields -->
        <field name="x_client_status" string="Client Status" />
        <field name="x_industry" string="Industry" />
        <field name="x_client_type" string="Client Type" />

        <separator />

        <!-- Filters -->
        <filter
          string="Client Status"
          name="filter_has_client_status"
          domain="[('x_client_status', '!=', False)]"
        />

        <filter
          string="Industry"
          name="filter_has_industry"
          domain="[('x_industry', '!=', False)]"
        />

        <filter
          string="Client Type"
          name="filter_has_client_type"
          domain="[('x_client_type', '!=', False)]"
        />

        <separator />

        <!-- Group By -->
        <filter
          string="Client Status"
          name="group_by_x_client_status"
          context="{'group_by': 'x_client_status'}"
        />

        <filter
          string="Industry"
          name="group_by_x_industry"
          context="{'group_by': 'x_industry'}"
        />

        <filter
          string="Client Type"
          name="group_by_x_client_type"
          context="{'group_by': 'x_client_type'}"
        />

      </xpath>

    </field>
  </record>

</odoo>