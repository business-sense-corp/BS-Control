<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Sprint List View -->
  <record id="view_bs_sprint_list" model="ir.ui.view">
    <field name="name">bs.sprint.list</field>
    <field name="model">bs.sprint</field>
    <field name="arch" type="xml">
      <list string="Sprints">
        <field name="name" />
        <field name="start_date" />
        <field name="end_date" />
        <field name="status" />
      </list>
    </field>
  </record>

  <!-- Sprint Form View -->
  <record id="view_bs_sprint_form" model="ir.ui.view">
    <field name="name">bs.sprint.form</field>
    <field name="model">bs.sprint</field>
    <field name="arch" type="xml">
      <form string="Sprint">
        <sheet>

          <group>
            <group>
              <field name="name" />
              <field name="start_date" />
              <field name="end_date" />
            </group>

            <group>
              <field name="status" />
            </group>
          </group>

          <notebook>

            <page string="Goal">
              <field name="goal" />
            </page>

            <page string="Sprint Items">
              <field
                name="sprint_item_ids"
                context="{'default_sprint_id': id}"
                readonly="status in ['active', 'closed', 'cancelled']"
              >
                <list editable="bottom">
                  <field name="name" />
                  <field name="backlog_item_id" />
                  <field name="project_id" />
                  <field name="assigned_user_id" />
                  <field name="estimated_hours" />
                  <field name="actual_hours" />
                  <field
                    name="remaining_hours"
                    readonly="1"
                  />
                  <field name="status" />
                  <field name="priority" />
                  <field name="end_date" />
                  <field
                    name="completion_percentage"
                    readonly="1"
                  />
                </list>
              </field>
            </page>

          </notebook>

        </sheet>
      </form>
    </field>
  </record>

  <!-- Active / Open Sprints Action -->
  <record id="action_bs_sprint" model="ir.actions.act_window">
    <field name="name">Sprints</field>
    <field name="res_model">bs.sprint</field>
    <field name="view_mode">list,form</field>
    <field name="domain">
      [('status', '!=', 'closed')]
    </field>
  </record>

  <!-- Done Sprints Action -->
  <record
    id="action_bs_done_sprint"
    model="ir.actions.act_window"
  >
    <field name="name">Done Sprints</field>
    <field name="res_model">bs.sprint</field>
    <field name="view_mode">list,form</field>
    <field name="domain">
      [('status', '=', 'closed')]
    </field>
  </record>

  <!-- Sprint Management Parent Menu -->
  <record id="menu_bs_sprint_management" model="ir.ui.menu">
    <field name="name">Sprint Management</field>
    <field
      name="parent_id"
      ref="menu_bs_control_root"
    />
    <field name="sequence">40</field>
    <field name="action" eval="False" />
  </record>

  <!-- Sprints Menu -->
  <menuitem
    id="menu_bs_sprint"
    name="Sprints"
    parent="menu_bs_sprint_management"
    action="action_bs_sprint"
    sequence="10"
  />

  <!-- Done Sprints Menu -->
  <menuitem
    id="menu_bs_done_sprint"
    name="Done Sprints"
    parent="menu_bs_sprint_management"
    action="action_bs_done_sprint"
    sequence="15"
  />

</odoo>