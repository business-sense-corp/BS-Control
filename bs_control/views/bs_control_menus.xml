<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Action: Open Clients -->
  <record id="action_bs_control_clients" model="ir.actions.act_window">
    <field name="name">Clients</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first BS Control client
      </p>
    </field>
  </record>


  <!-- Action: Open Projects -->
  <record id="action_bs_control_projects" model="ir.actions.act_window">
    <field name="name">Projects</field>
    <field name="res_model">project.project</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first BS Control project
      </p>
    </field>
  </record>


  <!-- Root App Menu -->
  <menuitem
    id="menu_bs_control_root"
    name="BS Control"
    sequence="10"
    action="action_bs_control_clients"
    web_icon="bs_control,static/description/icon.png"
    groups="base.group_user"
  />


  <!-- Clients Menu -->
  <menuitem
    id="menu_bs_control_clients"
    name="Clients"
    parent="menu_bs_control_root"
    action="action_bs_control_clients"
    sequence="10"
    groups="base.group_user"
  />


  <!-- Projects Menu -->
  <menuitem
    id="menu_bs_control_projects"
    name="Projects"
    parent="menu_bs_control_root"
    action="action_bs_control_projects"
    sequence="20"
    groups="base.group_user"
  />

   <!-- Dashboard -->
    <menuitem
            id="menu_bs_control_dashboard"
            name="Dashboard"
            parent="menu_bs_control_root"
            sequence="5"
    />

    <!-- Backlog -->
    <menuitem
            id="menu_bs_control_backlog"
            name="Backlog"
            parent="menu_bs_control_root"
            action="action_bs_backlog"
            sequence="30"
    />

    <!-- Configuration -->
    <menuitem
            id="menu_bs_control_configuration"
            name="Configuration"
            parent="menu_bs_control_root"
            sequence="100"
    />

    <!-- Config Menus -->
    <menuitem
            id="menu_bs_control_task_types"
            name="Task Types"
            parent="menu_bs_control_configuration"
            sequence="10"
    />

    <menuitem
            id="menu_bs_control_statuses"
            name="Statuses"
            parent="menu_bs_control_configuration"
            sequence="20"
    />

    <menuitem
            id="menu_bs_control_priorities"
            name="Priorities"
            parent="menu_bs_control_configuration"
            sequence="30"
    />


</odoo>