    <record id="view_partner_form_inherit_projects" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.projects</field>
        <field name="model">res.partner</field>

        <field name="inherit_id" ref="base.view_partner_form"/>

        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_open_projects"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-folder-open">

                    <field name="project_count"
                           string="Projects"
                           widget="statinfo"/>

                </button>

            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Projects">

                            <field name="project_ids">

                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="estimated_cost"/>
                                </list>

                            </field>

                        </page>
            </xpath>

        </field>
    </record>


    <!-- ACTION -->
    <record id="action_project_customers" model="ir.actions.act_window">
        <field name="name">Project Customers</field>

        <field name="res_model">res.partner</field>

        <field name="view_mode">list,form</field>

        <field name="domain">
            [('project_ids', '!=', False)]
        </field>
    </record>


    <!-- MENU -->
    <menuitem
            id="menu_project_customers"
            name="Project Customers"
            parent="project.menu_project_config"
            action="action_project_customers"
            sequence="50"/>

</odoo>